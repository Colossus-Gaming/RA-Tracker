                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Settings_General}"
                                               Style="{StaticResource SectionHeader}"/>
                                    <CheckBox Content="Auto-start polling when application opens" IsChecked="{Binding AutoStart}"/>

                                    <!-- Language. Bound through LocalizationService's indexer, so switching
                                         re-reads every localised string in place with no restart. -->
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <TextBlock Text="{loc:Loc Settings_Language}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                                   Foreground="{StaticResource TextSecondary}"/>
                                        <ComboBox x:Name="LanguageComboBox" Width="190"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectionChanged="LanguageComboBox_SelectionChanged"/>
                                    </StackPanel>
                                    <TextBlock Text="{loc:Loc Settings_LanguageHint}"
                                               TextWrapping="Wrap" Margin="0,8,0,0"
                                               FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Position Mode (OBS Setup)" Style="{StaticResource SectionHeader}"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" Margin="0,0,0,10">
                                        <Run Text="Enable Position Mode per window to show its outline and drag it into place. Each window is fully transparent for OBS capture when its box is unchecked. "/>
                                        <Run Text="Uncheck all" FontWeight="SemiBold" Foreground="{StaticResource AccentGreen}"/>
                                        <Run Text=" before going live."/>
                                    </TextBlock>
                                    <UniformGrid Columns="2">
                                        <CheckBox x:Name="FocusPositionModeCheckBox" Content="Focus" Margin="0,3"
                                                  Checked="OverlayPositionModeCheckBox_Changed" Unchecked="OverlayPositionModeCheckBox_Changed"/>
                                        <CheckBox x:Name="AlertsPositionModeCheckBox" Content="Alerts" Margin="0,3"
                                                  Checked="OverlayPositionModeCheckBox_Changed" Unchecked="OverlayPositionModeCheckBox_Changed"/>
                                        <CheckBox x:Name="UserInfoPositionModeCheckBox" Content="User Info" Margin="0,3"
                                                  Checked="OverlayPositionModeCheckBox_Changed" Unchecked="OverlayPositionModeCheckBox_Changed"/>
                                        <CheckBox x:Name="GameInfoPositionModeCheckBox" Content="Game Info" Margin="0,3"
                                                  Checked="OverlayPositionModeCheckBox_Changed" Unchecked="OverlayPositionModeCheckBox_Changed"/>
                                        <CheckBox x:Name="GameProgressPositionModeCheckBox" Content="Game Progress" Margin="0,3"
                                                  Checked="OverlayPositionModeCheckBox_Changed" Unchecked="OverlayPositionModeCheckBox_Changed"/>
                                        <CheckBox x:Name="RecentUnlocksPositionModeCheckBox" Content="Recent Unlocks" Margin="0,3"
                                                  Checked="OverlayPositionModeCheckBox_Changed" Unchecked="OverlayPositionModeCheckBox_Changed"/>
                                        <CheckBox x:Name="AchievementListPositionModeCheckBox" Content="Achievement List" Margin="0,3"
                                                  Checked="OverlayPositionModeCheckBox_Changed" Unchecked="OverlayPositionModeCheckBox_Changed"/>
                                        <CheckBox x:Name="RelatedMediaPositionModeCheckBox" Content="Related Media" Margin="0,3"
                                                  Checked="OverlayPositionModeCheckBox_Changed" Unchecked="OverlayPositionModeCheckBox_Changed"/>
                                    </UniformGrid>
                                    <TextBlock Margin="0,8,0,0" FontSize="11">
                                        <Run Text="Tip:" Foreground="{StaticResource AccentBlue}" FontWeight="SemiBold"/>
                                        <Run Text=" You can also press 'P' while an overlay window is focused to toggle its position mode." Foreground="{StaticResource TextMuted}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Refocus Behavior" Style="{StaticResource SectionHeader}"/>
                                    <TextBlock Text="When the current focus achievement is unlocked:" 
                                               Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>
                                    <RadioButton Content="Go to next achievement in list" 
                                                 IsChecked="{Binding RefocusBehavior, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=GO_TO_NEXT}"
                                                 GroupName="RefocusBehavior" Margin="0,3"
                                                 Foreground="{StaticResource TextSecondary}"/>
                                    <RadioButton Content="Go to first achievement in list" 
                                                 IsChecked="{Binding RefocusBehavior, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=GO_TO_FIRST}"
                                                 GroupName="RefocusBehavior" Margin="0,3"
                                                 Foreground="{StaticResource TextSecondary}"/>
                                    <RadioButton Content="Go to random locked achievement" 
                                                 IsChecked="{Binding RefocusBehavior, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=GO_TO_RANDOM}"
                                                 GroupName="RefocusBehavior" Margin="0,3"
                                                 Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="API Settings" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="Configure RetroAchievements API behavior:" 
                                           Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>
                                <CheckBox Content="Enable API request logging"
                                          IsChecked="{Binding EnableApiLogging}"
                                          ToolTip="Log all API requests to the debug output. Useful for troubleshooting."/>
                                <Separator Margin="0,12" Background="{StaticResource BackgroundLight}"/>
                                <TextBlock Text="V2 API Connectivity" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
                                <TextBlock Text="Test whether the app can reach the RetroAchievements V2 API through Cloudflare."
                                           Foreground="{StaticResource TextMuted}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="TestV2Button" AutomationProperties.AutomationId="TestV2Button" Style="{StaticResource ModernButton}" Click="TestV2Connection_Click" Padding="10,6" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="Test V2 Connection" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock x:Name="V2TestResult" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="OBS Integration (File Source)" Style="{StaticResource SectionHeader}"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" Margin="0,0,0,10">
                                        <Run Text="Stream labels generate .txt files for use with OBS"/>
                                        <Run Text="Text (GDI+)" FontWeight="SemiBold" Foreground="{StaticResource AccentBlue}"/>
                                        <Run Text="sources. In OBS, add a Text source, check"/>
                                        <Run Text="'Read from file'" FontWeight="SemiBold" Foreground="{StaticResource AccentGreen}"/>
                                        <Run Text="and browse to the appropriate .txt file."/>
                                    </TextBlock>
                                    <CheckBox Content="Enable stream label file generation" 
                                              IsChecked="{Binding EnableStreamLabels}"
                                              ToolTip="Writes text files to the stream-labels/ folder for OBS integration. Includes user info, game info, current focus, recent unlocks, and achievement alerts. Supports multi-set games with set-name.txt and current-set.txt files."/>
                                    <Button x:Name="OpenStreamLabelsFolder"
                                            Style="{StaticResource ModernButton}"
                                            Click="OpenStreamLabelsFolder_Click"
                                            HorizontalAlignment="Left"
                                            Margin="0,8,0,0"
                                            ToolTip="Open the stream-labels folder in Windows Explorer">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="Open stream-labels Folder" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Recent Unlocks Timezone" Style="{StaticResource SectionHeader}"/>
                                    <TextBlock Text="Configure the timezone for displaying achievement unlock times in the Recent Unlocks overlay:" 
                                               Foreground="{StaticResource TextMuted}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                    <CheckBox Content="Auto-detect timezone (use system setting)" 
                                              IsChecked="{Binding RecentUnlocksAutoDetectTimezone}"
                                              ToolTip="When enabled, uses your system's local timezone automatically."/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="Timezone:" VerticalAlignment="Center" Margin="0,0,10,0"
                                                   Foreground="{StaticResource TextSecondary}"/>
                                        <ComboBox ItemsSource="{Binding AvailableTimezones}"
                                                  SelectedItem="{Binding SelectedTimezone, Mode=TwoWay}"
                                                  IsEnabled="{Binding IsTimezoneSelectionEnabled}"
                                                  Width="400"
                                                  ToolTip="Select a timezone for displaying achievement unlock times">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayName}" Foreground="Black"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <TextBlock Margin="0,8,0,0" FontSize="11">
                                        <Run Text="Current setting:" Foreground="{StaticResource TextMuted}"/>
                                        <Run Text="{Binding EffectiveTimezone, Mode=OneWay}" Foreground="{StaticResource AccentGreen}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Auto-Launch Windows" Style="{StaticResource SectionHeader}"/>
                                    <TextBlock Text="These windows will automatically open when polling starts:" 
                                               Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>
                                    <CheckBox Content="Focus Window" IsChecked="{Binding AutoLaunchFocus}"/>
                                    <CheckBox Content="Alerts Window" IsChecked="{Binding AutoLaunchAlerts}"/>
                                    <CheckBox Content="User Info Window" IsChecked="{Binding AutoLaunchUserInfo}"/>
                                    <CheckBox Content="Game Info Window" IsChecked="{Binding AutoLaunchGameInfo}"/>
                                    <CheckBox Content="Game Progress Window" IsChecked="{Binding AutoLaunchGameProgress}"/>
                                    <CheckBox Content="Recent Unlocks Window" IsChecked="{Binding AutoLaunchRecentUnlocks}"/>
                                    <CheckBox Content="Achievement List Window" IsChecked="{Binding AutoLaunchAchievementList}"/>
                                    <CheckBox Content="Related Media Window" IsChecked="{Binding AutoLaunchRelatedMedia}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

            <!-- Guides Page -->
            <Grid x:Name="GuidesPage" Visibility="Collapsed">
                <Grid.RenderTransform>
                    <TranslateTransform/>
                </Grid.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="{StaticResource BackgroundMedium}" Padding="10">
                        <DockPanel>
                            <Button Content="{loc:Loc Settings_Back}" ContentStringFormat="&#x2190; {0}" Style="{StaticResource BackButton}" Click="NavigateBackToDashboard_Click" DockPanel.Dock="Left"/>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="10,0,0,0">
                                <Button Style="{StaticResource ModernButton}" Click="GuidesRefresh_Click" Padding="6,4" ToolTip="Refresh">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets"/>
                                </Button>
                                <Button Style="{StaticResource ModernButton}" Click="OpenGuideInBrowser_Click" Padding="6,4" ToolTip="Open in browser">
                                    <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets"/>
                                </Button>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource PageHeader}" Margin="10,0,0,0">
                                <Run Text="&#xE82D;" FontFamily="Segoe MDL2 Assets"/>
                                <Run Text=" RA Guide"/>
                            </TextBlock>
                            <TextBlock Text="{Binding GameTitle}" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="14" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Border>

                    <!-- WebView2 Browser -->
                    <wv2:WebView2 x:Name="GuidesWebView" Grid.Row="1"
                                  DefaultBackgroundColor="Transparent"/>
                </Grid>
            </Grid>
            </Grid>

    </Grid>
</Window>
