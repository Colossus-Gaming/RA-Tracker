                                            Command="{Binding OpenAchievementListOverlayCommand}"/>
                                    <Button x:Name="ResetAchievementListLayoutButton" Content="Reset to Defaults" 
                                            Style="{StaticResource ModernButton}" Click="ResetAchievementListLayoutButton_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}"><Run Text="&#xE740;" FontFamily="Segoe MDL2 Assets"/><Run Text=" Window Size"/></TextBlock>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Width" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                        <Slider x:Name="AchievementListWidthSlider" Minimum="400" Maximum="1200" 
                                                Value="680" TickFrequency="50" IsSnapToTickEnabled="True"
                                                ValueChanged="AchievementListLayoutSlider_ValueChanged"/>
                                        <TextBlock Text="{Binding ElementName=AchievementListWidthSlider, Path=Value, StringFormat={}{0:F0} px}" 
                                                   Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Height" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                        <Slider x:Name="AchievementListHeightSlider" Minimum="300" Maximum="900" 
                                                Value="500" TickFrequency="50" IsSnapToTickEnabled="True"
                                                ValueChanged="AchievementListLayoutSlider_ValueChanged"/>
                                        <TextBlock Text="{Binding ElementName=AchievementListHeightSlider, Path=Value, StringFormat={}{0:F0} px}" 
                                                   Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}"><Run Text="&#xE7C1;" FontFamily="Segoe MDL2 Assets"/><Run Text=" Badge Settings"/></TextBlock>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Badge Size" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                        <Slider x:Name="AchievementListBadgeSizeSlider" Minimum="32" Maximum="128" 
                                                Value="64" TickFrequency="8" IsSnapToTickEnabled="True"
                                                ValueChanged="AchievementListLayoutSlider_ValueChanged"/>
                                        <TextBlock Text="{Binding ElementName=AchievementListBadgeSizeSlider, Path=Value, StringFormat={}{0:F0} px}" 
                                                   Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Badge Spacing" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                        <Slider x:Name="AchievementListBadgeSpacingSlider" Minimum="0" Maximum="20" 
                                                Value="4" TickFrequency="2" IsSnapToTickEnabled="True"
                                                ValueChanged="AchievementListLayoutSlider_ValueChanged"/>
                                        <TextBlock Text="{Binding ElementName=AchievementListBadgeSpacingSlider, Path=Value, StringFormat={}{0:F0} px}" 
                                                   Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}"><Run Text="&#xE762;" FontFamily="Segoe MDL2 Assets"/><Run Text=" Display Options"/></TextBlock>
                                <CheckBox x:Name="AchievementListShowUnlockedFirstCheckBox" Content="Show unlocked achievements first" IsChecked="True"
                                          Checked="AchievementListOptionsCheckBox_Changed" Unchecked="AchievementListOptionsCheckBox_Changed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Related Media Settings Page -->
            <Grid x:Name="RelatedMediaSettingsPage" Visibility="Collapsed">
                <Grid.RenderTransform>
                    <TranslateTransform/>
                </Grid.RenderTransform>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <!-- Header with Back Button -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Button Content="&#x2190; Back" Style="{StaticResource BackButton}" Click="NavigateBackToDashboard_Click"/>
                            <TextBlock Style="{StaticResource PageHeader}"><Run Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets"/><Run Text=" Related Media Settings"/></TextBlock>
                        </StackPanel>
                        
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Related Media Overlay" Style="{StaticResource SectionHeader}"/>
                                <CheckBox Content="Auto-launch Related Media window on start" IsChecked="{Binding AutoLaunchRelatedMedia}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Open Related Media Window" Style="{StaticResource PrimaryButton}" 
                                            Command="{Binding OpenRelatedMediaOverlayCommand}"/>
                                    <Button x:Name="ResetRelatedMediaLayoutButton" Content="Reset to Defaults" 
                                            Style="{StaticResource ModernButton}" Click="ResetRelatedMediaLayoutButton_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}"><Run Text="&#xE740;" FontFamily="Segoe MDL2 Assets"/><Run Text=" Window Size"/></TextBlock>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Width" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                        <Slider x:Name="RelatedMediaWidthSlider" Minimum="300" Maximum="1200" 
                                                Value="640" TickFrequency="50" IsSnapToTickEnabled="True"
                                                ValueChanged="RelatedMediaLayoutSlider_ValueChanged"/>
                                        <TextBlock Text="{Binding ElementName=RelatedMediaWidthSlider, Path=Value, StringFormat={}{0:F0} px}" 
                                                   Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Height" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                        <Slider x:Name="RelatedMediaHeightSlider" Minimum="200" Maximum="900" 
                                                Value="480" TickFrequency="50" IsSnapToTickEnabled="True"
                                                ValueChanged="RelatedMediaLayoutSlider_ValueChanged"/>
                                        <TextBlock Text="{Binding ElementName=RelatedMediaHeightSlider, Path=Value, StringFormat={}{0:F0} px}" 
                                                   Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}"><Run Text="&#xE71D;" FontFamily="Segoe MDL2 Assets"/><Run Text=" Container Settings"/></TextBlock>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Container Corner Radius" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                        <Slider x:Name="RelatedMediaContainerCornerSlider" Minimum="0" Maximum="30" 
                                                Value="8" TickFrequency="2" IsSnapToTickEnabled="True"
                                                ValueChanged="RelatedMediaLayoutSlider_ValueChanged"/>
                                        <TextBlock Text="{Binding ElementName=RelatedMediaContainerCornerSlider, Path=Value, StringFormat={}{0:F0} px}" 
                                                   Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Image Corner Radius" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                        <Slider x:Name="RelatedMediaImageCornerSlider" Minimum="0" Maximum="30" 
                                                Value="5" TickFrequency="2" IsSnapToTickEnabled="True"
                                                ValueChanged="RelatedMediaLayoutSlider_ValueChanged"/>
                                        <TextBlock Text="{Binding ElementName=RelatedMediaImageCornerSlider, Path=Value, StringFormat={}{0:F0} px}" 
                                                   Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- General Settings Page -->
                <Grid x:Name="GeneralSettingsPage" Visibility="Collapsed">
                    <Grid.RenderTransform>
                        <TranslateTransform/>
                    </Grid.RenderTransform>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="15">
                            <!-- Header with Back Button -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <Button Content="&#x2190; Back" Style="{StaticResource BackButton}" Click="NavigateBackToDashboard_Click"/>
                                <TextBlock Style="{StaticResource PageHeader}"><Run Text="&#xE713;" FontFamily="Segoe MDL2 Assets"/><Run Text=" General Settings"/></TextBlock>
                            </StackPanel>
                        
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="General Settings" Style="{StaticResource SectionHeader}"/>
                                    <CheckBox Content="Auto-start polling when application opens" IsChecked="{Binding AutoStart}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Position Mode (OBS Setup)" Style="{StaticResource SectionHeader}"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" Margin="0,0,0,10">
                                        <Run Text="When Position Mode is enabled, overlay windows show a visible border and can be dragged to position them. "/>
                                        <Run Text="Disable Position Mode" FontWeight="SemiBold" Foreground="{StaticResource AccentGreen}"/>
                                        <Run Text=" before going live to ensure overlays are fully transparent for OBS capture."/>
                                    </TextBlock>
                                    <CheckBox Content="Enable Position Mode (show overlay borders for positioning)" 
                                              IsChecked="{Binding PositionModeEnabled}"
                                              ToolTip="When enabled, overlay windows show positioning guides and can be dragged. Disable for clean OBS capture."/>
                                    <TextBlock Margin="0,8,0,0" FontSize="11">
                                        <Run Text="Tip:" Foreground="{StaticResource AccentBlue}" FontWeight="SemiBold"/>
                                        <Run Text=" You can also press 'P' while an overlay window is focused to toggle position mode." Foreground="{StaticResource TextMuted}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Refocus Behavior" Style="{StaticResource SectionHeader}"/>
                                    <TextBlock Text="When the current focus achievement is unlocked:" 
                                               Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>
                                    <RadioButton Content="Go to next achievement in list" 
                                                 IsChecked="{Binding RefocusBehavior, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=GO_TO_NEXT}"
                                                 GroupName="RefocusBehavior" Margin="0,3"
                                                 Foreground="{StaticResource TextSecondary}"/>
                                    <RadioButton Content="Go to first achievement in list" 
                                                 IsChecked="{Binding RefocusBehavior, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=GO_TO_FIRST}"
                                                 GroupName="RefocusBehavior" Margin="0,3"
                                                 Foreground="{StaticResource TextSecondary}"/>
                                    <RadioButton Content="Go to random locked achievement" 
                                                 IsChecked="{Binding RefocusBehavior, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=GO_TO_RANDOM}"
                                                 GroupName="RefocusBehavior" Margin="0,3"
                                                 Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="API Settings" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="Configure RetroAchievements API behavior:" 
                                           Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>
                                <CheckBox Content="Enable API request logging"
                                          IsChecked="{Binding EnableApiLogging}"
                                          ToolTip="Log all API requests to the debug output. Useful for troubleshooting."/>
                                <Separator Margin="0,12" Background="{StaticResource BackgroundLight}"/>
                                <TextBlock Text="V2 API Connectivity" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
                                <TextBlock Text="Test whether the app can reach the RetroAchievements V2 API through Cloudflare."
                                           Foreground="{StaticResource TextMuted}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="TestV2Button" AutomationProperties.AutomationId="TestV2Button" Style="{StaticResource ModernButton}" Click="TestV2Connection_Click" Padding="10,6" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="Test V2 Connection" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock x:Name="V2TestResult" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="OBS Integration (File Source)" Style="{StaticResource SectionHeader}"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" Margin="0,0,0,10">
                                        <Run Text="Stream labels generate .txt files for use with OBS"/>
                                        <Run Text="Text (GDI+)" FontWeight="SemiBold" Foreground="{StaticResource AccentBlue}"/>
                                        <Run Text="sources. In OBS, add a Text source, check"/>
                                        <Run Text="'Read from file'" FontWeight="SemiBold" Foreground="{StaticResource AccentGreen}"/>
                                        <Run Text="and browse to the appropriate .txt file."/>
                                    </TextBlock>
                                    <CheckBox Content="Enable stream label file generation" 
                                              IsChecked="{Binding EnableStreamLabels}"
                                              ToolTip="Writes text files to the stream-labels/ folder for OBS integration. Includes user info, game info, current focus, recent unlocks, and achievement alerts. Supports multi-set games with set-name.txt and current-set.txt files."/>
                                    <Button x:Name="OpenStreamLabelsFolder"
                                            Style="{StaticResource ModernButton}"
                                            Click="OpenStreamLabelsFolder_Click"
                                            HorizontalAlignment="Left"
                                            Margin="0,8,0,0"
                                            ToolTip="Open the stream-labels folder in Windows Explorer">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="Open stream-labels Folder" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Recent Unlocks Timezone" Style="{StaticResource SectionHeader}"/>
                                    <TextBlock Text="Configure the timezone for displaying achievement unlock times in the Recent Unlocks overlay:" 
                                               Foreground="{StaticResource TextMuted}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                    <CheckBox Content="Auto-detect timezone (use system setting)" 
                                              IsChecked="{Binding RecentUnlocksAutoDetectTimezone}"
                                              ToolTip="When enabled, uses your system's local timezone automatically."/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="Timezone:" VerticalAlignment="Center" Margin="0,0,10,0"
                                                   Foreground="{StaticResource TextSecondary}"/>
                                        <ComboBox ItemsSource="{Binding AvailableTimezones}"
                                                  SelectedItem="{Binding SelectedTimezone, Mode=TwoWay}"
                                                  IsEnabled="{Binding IsTimezoneSelectionEnabled}"
                                                  Width="400"
                                                  ToolTip="Select a timezone for displaying achievement unlock times">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayName}" Foreground="Black"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <TextBlock Margin="0,8,0,0" FontSize="11">
                                        <Run Text="Current setting:" Foreground="{StaticResource TextMuted}"/>
                                        <Run Text="{Binding EffectiveTimezone, Mode=OneWay}" Foreground="{StaticResource AccentGreen}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Auto-Launch Windows" Style="{StaticResource SectionHeader}"/>
                                    <TextBlock Text="These windows will automatically open when polling starts:" 
                                               Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>
                                    <CheckBox Content="Focus Window" IsChecked="{Binding AutoLaunchFocus}"/>
                                    <CheckBox Content="Alerts Window" IsChecked="{Binding AutoLaunchAlerts}"/>
                                    <CheckBox Content="User Info Window" IsChecked="{Binding AutoLaunchUserInfo}"/>
                                    <CheckBox Content="Game Info Window" IsChecked="{Binding AutoLaunchGameInfo}"/>
                                    <CheckBox Content="Game Progress Window" IsChecked="{Binding AutoLaunchGameProgress}"/>
                                    <CheckBox Content="Recent Unlocks Window" IsChecked="{Binding AutoLaunchRecentUnlocks}"/>
                                    <CheckBox Content="Achievement List Window" IsChecked="{Binding AutoLaunchAchievementList}"/>
                                    <CheckBox Content="Related Media Window" IsChecked="{Binding AutoLaunchRelatedMedia}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

            <!-- Guides Page -->
            <Grid x:Name="GuidesPage" Visibility="Collapsed">
                <Grid.RenderTransform>
                    <TranslateTransform/>
                </Grid.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="{StaticResource BackgroundMedium}" Padding="10">
                        <DockPanel>
                            <Button Content="&#x2190; Back" Style="{StaticResource BackButton}" Click="NavigateBackToDashboard_Click" DockPanel.Dock="Left"/>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="10,0,0,0">
                                <Button Style="{StaticResource ModernButton}" Click="GuidesRefresh_Click" Padding="6,4" ToolTip="Refresh">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets"/>
                                </Button>
                                <Button Style="{StaticResource ModernButton}" Click="OpenGuideInBrowser_Click" Padding="6,4" ToolTip="Open in browser">
                                    <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets"/>
                                </Button>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource PageHeader}" Margin="10,0,0,0">
                                <Run Text="&#xE82D;" FontFamily="Segoe MDL2 Assets"/>
                                <Run Text=" RA Guide"/>
                            </TextBlock>
                            <TextBlock Text="{Binding GameTitle}" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="14" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Border>

                    <!-- WebView2 Browser -->
                    <wv2:WebView2 x:Name="GuidesWebView" Grid.Row="1"
                                  DefaultBackgroundColor="Transparent"/>
                </Grid>
            </Grid>
            </Grid>

    </Grid>
</Window>
