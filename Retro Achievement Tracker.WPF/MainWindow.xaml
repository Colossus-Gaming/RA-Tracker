<Window x:Class="RATracker.WPF.MainWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:vm="clr-namespace:RATracker.WPF.ViewModels"
xmlns:converters="clr-namespace:RATracker.WPF.Converters"
xmlns:behaviors="clr-namespace:RATracker.WPF.Behaviors"
xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
xmlns:loc="clr-namespace:RATracker.WPF.Localization"
mc:Ignorable="d"
Title="{loc:Loc App_Title}"
Height="790" Width="900"
        ResizeMode="CanMinimize"
        Background="#1E1E1E"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=True}">

    <Window.Resources>
        <!-- Converters -->
        <converters:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
        <converters:SetTypeToAccentBrushConverter x:Key="SetTypeToAccentBrush"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        
        <!-- Color Palette -->
        <SolidColorBrush x:Key="BackgroundDark" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="BackgroundMedium" Color="#252526"/>
        <SolidColorBrush x:Key="BackgroundLight" Color="#333333"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#007ACC"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#4EC9B0"/>
        <SolidColorBrush x:Key="AccentGold" Color="#FFD700"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="TextMuted" Color="#888888"/>
        <SolidColorBrush x:Key="BorderColor" Color="#3C3C3C"/>
        
        <!-- Slide Animation Storyboards -->
        <Storyboard x:Key="SlideOutLeft">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="0" To="-50" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.25"/>
        </Storyboard>
        
        <Storyboard x:Key="SlideInRight">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="50" To="0" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.25"/>
        </Storyboard>
        
        <Storyboard x:Key="SlideOutRight">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="0" To="50" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.25"/>
        </Storyboard>
        
        <Storyboard x:Key="SlideInLeft">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="-50" To="0" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.25"/>
        </Storyboard>

        <!-- Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BackgroundLight}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4C4C4C"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Icon Button Style (for settings gear buttons) -->
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="MinWidth" Value="30"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="ToolTip" Value="Settings"/>
        </Style>
        
        <!-- Back Button Style -->
        <Style x:Key="BackButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <!-- Primary Button -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1C97EA"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Success Button -->
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#2D7D46"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3D9D56"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Danger Button -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#C42B1C"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E43E2C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BackgroundLight}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- PasswordBox Style -->
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource BackgroundLight}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Label Style -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Margin" Value="3,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Foreground" Value="Black"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TabControl Style -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}"
                                BorderThickness="0,0,0,2"
                                BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" 
                                              HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource BackgroundLight}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- GroupBox Style -->
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <!-- Card Style -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BackgroundMedium}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="15"/>
            <!-- 10px on every side → a uniform 20px gutter between adjacent cards. Paired with the
                 dashboard grid's Margin="0" so the outer margin (ContentArea 10 + card 10 = 20) matches. -->
            <Setter Property="Margin" Value="10"/>
        </Style>

        <!-- Rounded completion bar. Uses a real ProgressBar so the fill is a proportion of the track
             rather than a pixel width — the previous Border bound its Width directly to the 0-100
             percentage, so the bar could never exceed 100px however wide the card was. -->
        <Style x:Key="CompletionBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="{StaticResource AccentGreen}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                            <!-- ProgressBar sizes PART_Indicator against PART_Track; both must exist. -->
                            <Border x:Name="PART_Track"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" CornerRadius="4"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section Header -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        
        <!-- Page Header Style -->
        <Style x:Key="PageHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
        </Style>

        <!-- Visibility Converters -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="*"/>      <!-- Content -->
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Border Grid.Row="0" Background="{StaticResource BackgroundMedium}" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Credentials -->
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="{loc:Loc Header_Username}" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                            <TextBox x:Name="UsernameTextBox"
                                     AutomationProperties.AutomationId="UsernameTextBox"
                                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                     Width="160"
                                     IsEnabled="{Binding IsNotPolling}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="{loc:Loc Header_Password}" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                            <PasswordBox x:Name="PasswordBox"
                                         AutomationProperties.AutomationId="PasswordBox"
                                         Width="180"
                                         IsEnabled="{Binding IsNotPolling}"
                                         PasswordChanged="PasswordBox_PasswordChanged"/>
                        </StackPanel>
                        <CheckBox Content="{loc:Loc Header_Remember}" IsChecked="{Binding RememberPassword}"
                                  Foreground="{StaticResource TextMuted}" FontSize="11"
                                  Margin="0,0,8,0" VerticalAlignment="Bottom" Padding="2,0,0,6"
                                  IsEnabled="{Binding IsNotPolling}"/>
                        <Button AutomationProperties.AutomationId="StartStopButton" Command="{Binding TogglePollingCommand}" MinWidth="90" VerticalAlignment="Bottom">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                    <!-- The glyph rides in Tag, not ContentStringFormat. A ContentPresenter
                                         caches the format string it was created with, so a trigger that swaps
                                         ContentStringFormat is silently ignored and the Stop state renders the
                                         play glyph. Tag is an ordinary DP and re-renders correctly. -->
                                    <Setter Property="Tag" Value="&#x25B6;"/>
                                    <Setter Property="Content" Value="{loc:Loc Header_Start}"/>
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <!-- Margin/Foreground are set explicitly because the window-wide
                                                     implicit TextBlock style would otherwise inject Margin="3"
                                                     and its own Foreground into the button face. -->
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                               Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding}"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                               Margin="0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Background" Value="#2D7D46"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#3D9D56"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsPolling}" Value="True">
                                            <Setter Property="Tag" Value="&#x25A0;"/>
                                            <Setter Property="Content" Value="{loc:Loc Header_Stop}"/>
                                            <Setter Property="Background" Value="#C42B1C"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsPolling}" Value="True"/>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="#E43E2C"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <!-- Session/API Status -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock AutomationProperties.AutomationId="SessionStatusText" Text="{Binding SessionStatus}" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                        <TextBlock Text=" | " Foreground="{StaticResource TextMuted}" FontSize="11"
                                   Visibility="{Binding HasApiStatus, Converter={StaticResource BoolToVis}}"/>
                        <!-- Staged-update notice. Updates never apply mid-session, so this is how the
                             user learns one is waiting for the next restart. -->
                        <TextBlock Text=" | " Foreground="{StaticResource TextMuted}" FontSize="11"
                                   Visibility="{Binding HasUpdateStatus, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock AutomationProperties.AutomationId="UpdateStatusText"
                                   Text="{Binding UpdateStatusText}" FontSize="11"
                                   Foreground="{StaticResource AccentGold}"
                                   Visibility="{Binding HasUpdateStatus, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock AutomationProperties.AutomationId="ApiStatusText" Text="{Binding ApiStatusText}" FontSize="11">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource AccentGreen}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUsingV1Fallback}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AccentGold}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <!-- User Profile (when logged in). This carries the whole user summary — motto, rank,
                     points, true points — because there is no longer a User Info dashboard card; the
                     handful of fields didn't warrant a panel of their own. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding HasUserInfo, Converter={StaticResource BoolToVis}}">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding UserDisplayName}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"
                                   HorizontalAlignment="Right"/>

                        <!-- Motto is optional; collapse it rather than leaving a blank line. Trimmed
                             so a long motto can't push the avatar off the header at MinWidth. -->
                        <TextBlock Text="{Binding UserMotto}"
                                   FontSize="11" FontStyle="Italic"
                                   Foreground="{StaticResource TextMuted}"
                                   HorizontalAlignment="Right"
                                   MaxWidth="260" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding UserMotto}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UserMotto}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Rank / points / true points, one line to stay compact next to the avatar. -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                            <TextBlock Text="{Binding UserRank}" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource AccentGold}"
                                       ToolTip="Site rank"/>
                            <TextBlock Text=" &#x2022; " FontSize="12" Foreground="{StaticResource BorderColor}"/>
                            <TextBlock Text="{Binding UserPoints}" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource AccentGreen}"
                                       ToolTip="Total points"/>
                            <TextBlock Text="{Binding UserTruePoints}" FontSize="11"
                                       Foreground="{StaticResource TextMuted}"
                                       Margin="4,0,0,0" VerticalAlignment="Center"
                                       ToolTip="True (weighted) points"/>
                        </StackPanel>
                    </StackPanel>
                    <Border CornerRadius="25" Width="50" Height="50" BorderThickness="2" BorderBrush="{StaticResource AccentBlue}"
                            VerticalAlignment="Center"
                            behaviors:ImageAsync.Source="{Binding UserProfilePicture}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content - Navigation Based -->
        <Grid Grid.Row="1" x:Name="ContentArea" Margin="10" ClipToBounds="True">
            
            <!-- Dashboard Page -->
            <Grid x:Name="DashboardPage">
                <Grid.RenderTransform>
                    <TranslateTransform/>
                </Grid.RenderTransform>
                <!-- Margin 0: card margins (10) supply all gutters so spacing is uniform. -->
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <!-- Fixed, not Auto: the Current Game card's natural height changes with its
                             content (set dropdown only shows for multiset games, guide links only
                             when a game is loaded, long titles wrap). Auto let those shove the row
                             below up and down on every game change. 240 fits the tallest case. -->
                        <RowDefinition Height="240"/>
                        <!-- Bottom row (Overlay Windows + Current Focus) takes the exact remainder.
                             The window is fixed size, so this resolves to a constant. -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Game Info Card. Spans the full top row: the User Info card that used to sit in
                         column 0 now lives in the header. A third column keeps the reclaimed width in
                         use by pulling the progress summary out to the right edge. -->
                    <Border Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}"><Run Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets"/><Run Text=" "/><Run Text="{loc:Loc Dash_CurrentGame}"/></TextBlock>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <!-- Fixed, not Auto: "0 / 634 achievements" and "MASTERED!" are
                                         different widths, and an Auto column would resize the details
                                         column next to it whenever the game changed. -->
                                    <ColumnDefinition Width="190"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="5" Width="80" Height="80" Margin="0,0,15,0"
                                        behaviors:ImageAsync.Source="{Binding CurrentGameBadgeUri}"/>
                                <StackPanel Grid.Column="1">
                                    <!-- Single line + ellipsis rather than wrapping: a wrapped title
                                         would add a second line and push the card past the fixed row
                                         height. Same treatment as the set name in the dropdown below. -->
                                    <TextBlock Text="{Binding GameTitle}" FontSize="18" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimary}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding GameTitle}"/>
                                    <TextBlock Text="{Binding GameConsole}" Foreground="{StaticResource AccentBlue}"/>
                                    
                                    <!-- Achievement Set Selector + set-type badge -->
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0"
                                                Visibility="{Binding HasAchievementSets, Converter={StaticResource BoolToVis}}">
                                        <!-- One TextBlock, two Runs: a second TextBlock would pick up the
                                             implicit Margin="3" and open a 6px hole before the colon. -->
                                        <TextBlock Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"><Run Text="{loc:Loc Dash_Set}"/><Run Text=": "/></TextBlock>
                                        <!-- Selected set-type badge, moved to the LEFT of the dropdown so a long
                                             set name can never push it off the panel/screen. -->
                                        <Border Margin="0,0,6,0" Padding="5,1" CornerRadius="5"
                                                VerticalAlignment="Center"
                                                Background="{Binding SelectedAchievementSet.SetType, Converter={StaticResource SetTypeToAccentBrush}}">
                                            <TextBlock Text="{Binding SelectedAchievementSet.TypeLabel}"
                                                       Foreground="White" FontWeight="Bold" FontSize="9" FontFamily="Segoe UI"/>
                                        </Border>
                                        <!-- Fixed-width when collapsed (name trims with an ellipsis); the open
                                             dropdown measures items unconstrained, so it expands to the widest full
                                             name and renders past the window edge onto the screen if needed. -->
                                        <ComboBox x:Name="AchievementSetComboBox"
                                                  ItemsSource="{Binding AvailableAchievementSets}"
                                                  SelectedItem="{Binding SelectedAchievementSet, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  Width="200"
                                                  HorizontalContentAlignment="Stretch"
                                                  ToolTip="{Binding SelectedAchievementSet.DisplayName}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!-- Per-row sub-set/core indicator (dropdown list only). -->
                                                        <Border x:Name="ItemTypePill" Grid.Column="0" Margin="0,0,6,0"
                                                                Padding="4,0" CornerRadius="3" VerticalAlignment="Center"
                                                                Background="{Binding SetType, Converter={StaticResource SetTypeToAccentBrush}}">
                                                            <TextBlock Text="{Binding TypeLabel}" Foreground="White"
                                                                       FontWeight="Bold" FontSize="8" FontFamily="Segoe UI"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Foreground="Black"
                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text=" (" Foreground="#666666"/>
                                                            <TextBlock Text="{Binding AchievementCount}" Foreground="#2D7D46"/>
                                                            <TextBlock Text=")" Foreground="#666666"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <DataTemplate.Triggers>
                                                        <!-- The collapsed selection box has no ComboBoxItem ancestor;
                                                             hide the per-row pill there (the external badge to the left
                                                             already shows the selected set's type). -->
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ComboBoxItem}}}" Value="{x:Null}">
                                                            <Setter TargetName="ItemTypePill" Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    
                                </StackPanel>

                                <!-- Progress summary, pinned to the right edge of the now full-width card. -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Top"
                                            HorizontalAlignment="Right" Margin="15,0,0,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Foreground="{StaticResource TextSecondary}"><Run Text="{loc:Loc Dash_Progress}"/><Run Text=": "/></TextBlock>
                                        <TextBlock Text="{Binding GameCompletionText}" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentGreen}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMastered}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentGold}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource TextSecondary}">
                                        <Run Text="{Binding GameAchievementsEarned, Mode=OneWay}"/>
                                        <Run Text="/"/>
                                        <Run Text="{Binding GameAchievementsTotal, Mode=OneWay}"/>
                                        <Run Text=" "/><Run Text="{loc:Loc Dash_Achievements}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                            
                            <!-- Progress Bar -->
                            <ProgressBar Style="{StaticResource CompletionBar}" Margin="0,10,0,0"
                                         Value="{Binding GameCompletionPercent, Mode=OneWay, FallbackValue=0}"/>

                            <!-- Guide Links -->
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                        Visibility="{Binding HasGameInfo, Converter={StaticResource BoolToVis}}">
                                <Button Style="{StaticResource ModernButton}" Click="NavigateToGuidesPage_Click"
                                        Padding="8,4" FontSize="12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE82D;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="{loc:Loc Dash_ViewGuide}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ModernButton}" Click="OpenGuideInBrowser_Click"
                                        Padding="8,4" FontSize="12" ToolTip="Open in browser">
                                    <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Focus Achievement Card -->
                    <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource Card}">
                        <DockPanel>
                            <!-- Header -->
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}"><Run Text="&#xE81D;" FontFamily="Segoe MDL2 Assets"/><Run Text=" "/><Run Text="{loc:Loc Dash_CurrentFocus}"/></TextBlock>
                            
                            <!-- Navigation Buttons -->
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                                <!-- MinWidth, not Width: translated captions are longer than English
                                     ("Precedente", "Imposta focus") and a fixed width clips them
                                     mid-word with no ellipsis. -->
                                <Button Content="{loc:Loc Dash_Prev}" ContentStringFormat="&#x25C0; {0}" Style="{StaticResource ModernButton}" Command="{Binding PreviousFocusCommand}" MinWidth="80"/>
                                <Button Content="{loc:Loc Dash_SetFocus}" Style="{StaticResource PrimaryButton}" Command="{Binding SetFocusCommand}" MinWidth="100"/>
                                <Button Content="{loc:Loc Dash_Next}" ContentStringFormat="{}{0} &#x25B6;" Style="{StaticResource ModernButton}" Command="{Binding NextFocusCommand}" MinWidth="80"/>
                            </StackPanel>
                            
                            <!-- Achievement Info - fills remaining space -->
                            <DockPanel>
                                <!-- Focus achievement badge -->
                                <Border DockPanel.Dock="Left" Width="64" Height="64" CornerRadius="5"
                                        Margin="0,0,12,0" VerticalAlignment="Top" ClipToBounds="True"
                                        behaviors:ImageAsync.Source="{Binding FocusBadgeUri}"
                                        Visibility="{Binding HasFocusAchievement, Converter={StaticResource BoolToVis}}"/>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Title -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding FocusTitle}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" VerticalAlignment="Top"/>

                                    <!-- Points (upper right) -->
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding FocusPoints}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentGold}"/>
                                        <TextBlock Text=" pts" FontSize="14" Foreground="{StaticResource TextMuted}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                    </StackPanel>

                                    <!-- Description -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding FocusDescription}" FontSize="13" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                </Grid>
                            </DockPanel>
                        </DockPanel>
                    </Border>

                    <!-- Overlay Windows Card -->
                    <Border Grid.Column="0" Grid.Row="1" Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Style="{StaticResource SectionHeader}" Margin="0"><Run Text="&#xE78B;" FontFamily="Segoe MDL2 Assets"/><Run Text=" "/><Run Text="{loc:Loc Dash_OverlayWindows}"/></TextBlock>
                                <Button Style="{StaticResource ModernButton}"
                                        Click="NavigateToGeneralSettings_Click"
                                        Padding="8,4" Margin="15,0,0,0" FontSize="13"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="{loc:Loc Dash_Settings}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Focus -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="2">
                                    <Button Style="{StaticResource ModernButton}" Command="{Binding OpenFocusOverlayCommand}" Width="140">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE81D;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="{loc:Loc Overlay_Focus}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Content="&#xE713;" Style="{StaticResource IconButton}" Click="NavigateToFocusSettings_Click" ToolTip="Focus Settings"/>
                                </StackPanel>
                                <!-- Alerts -->
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="2">
                                    <Button Style="{StaticResource ModernButton}" Command="{Binding OpenAlertsOverlayCommand}" Width="140">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="{loc:Loc Overlay_Alerts}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Content="&#xE713;" Style="{StaticResource IconButton}" Click="NavigateToAlertsSettings_Click" ToolTip="Alerts Settings"/>
                                </StackPanel>
                                <!-- User Info -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="2">
                                    <Button Style="{StaticResource ModernButton}" Command="{Binding OpenUserInfoOverlayCommand}" Width="140">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="{loc:Loc Overlay_UserInfo}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Content="&#xE713;" Style="{StaticResource IconButton}" Click="NavigateToUserInfoSettings_Click" ToolTip="User Info Settings"/>
                                </StackPanel>
                                <!-- Game Info -->
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="2">
                                    <Button Style="{StaticResource ModernButton}" Command="{Binding OpenGameInfoOverlayCommand}" Width="140">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="{loc:Loc Overlay_GameInfo}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Content="&#xE713;" Style="{StaticResource IconButton}" Click="NavigateToGameInfoSettings_Click" ToolTip="Game Info Settings"/>
                                </StackPanel>
                                <!-- Progress -->
                                <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="2">
                                    <Button Style="{StaticResource ModernButton}" Command="{Binding OpenGameProgressOverlayCommand}" Width="140">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="{loc:Loc Overlay_Progress}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Content="&#xE713;" Style="{StaticResource IconButton}" Click="NavigateToGameProgressSettings_Click" ToolTip="Progress Settings"/>
                                </StackPanel>
                                <!-- Recent -->
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="2">
                                    <Button Style="{StaticResource ModernButton}" Command="{Binding OpenRecentUnlocksOverlayCommand}" Width="140">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="{loc:Loc Overlay_Recent}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Content="&#xE713;" Style="{StaticResource IconButton}" Click="NavigateToRecentUnlocksSettings_Click" ToolTip="Recent Unlocks Settings"/>
                                </StackPanel>
                                <!-- All Cheevos -->
                                <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Margin="2">
                                    <Button Style="{StaticResource ModernButton}" Command="{Binding OpenAchievementListOverlayCommand}" Width="140">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="{loc:Loc Overlay_CheevoSet}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Content="&#xE713;" Style="{StaticResource IconButton}" Click="NavigateToAchievementListSettings_Click" ToolTip="Achievement List Settings"/>
                                </StackPanel>
                                <!-- Media -->
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="2">
                                    <Button Style="{StaticResource ModernButton}" Command="{Binding OpenRelatedMediaOverlayCommand}" Width="140">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="{loc:Loc Overlay_Media}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Content="&#xE713;" Style="{StaticResource IconButton}" Click="NavigateToRelatedMediaSettings_Click" ToolTip="Media Settings"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Focus Settings Page -->
            <Grid x:Name="FocusSettingsPage" Visibility="Collapsed">
                <Grid.RenderTransform>
                    <TranslateTransform/>
                </Grid.RenderTransform>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <!-- Header with Back Button -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Button Content="{loc:Loc Settings_Back}" ContentStringFormat="&#x2190; {0}" Style="{StaticResource BackButton}" Click="NavigateBackToDashboard_Click"/>
                            <TextBlock Style="{StaticResource PageHeader}"><Run Text="&#xE81D;" FontFamily="Segoe MDL2 Assets"/><Run Text=" Focus Settings"/></TextBlock>
                        </StackPanel>
                        
                        <!-- Quick Actions -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Focus Overlay" Style="{StaticResource SectionHeader}"/>
                                <CheckBox Content="Auto-launch Focus window on start" IsChecked="{Binding AutoLaunchFocus}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Open Focus Window" Style="{StaticResource PrimaryButton}" 
                                            Command="{Binding OpenFocusOverlayCommand}"/>
                                    <Button x:Name="ResetFocusLayoutButton" Content="{loc:Loc Alerts_ResetDefaults}"
                                            Style="{StaticResource ModernButton}" Click="ResetFocusLayoutButton_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        
                        <!-- Layout Settings -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}"><Run Text="&#xE740;" FontFamily="Segoe MDL2 Assets"/><Run Text=" Window Size"/></TextBlock>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Width" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                        <Slider x:Name="FocusWidthSlider" Minimum="300" Maximum="1200" 
                                                Value="700" TickFrequency="50" IsSnapToTickEnabled="True"
                                                ValueChanged="FocusLayoutSlider_ValueChanged"/>
                                        <TextBlock Text="{Binding ElementName=FocusWidthSlider, Path=Value, StringFormat={}{0:F0} px}" 
                                                   Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Height" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                        <Slider x:Name="FocusHeightSlider" Minimum="100" Maximum="400" 
                                                Value="175" TickFrequency="25" IsSnapToTickEnabled="True"
                                                ValueChanged="FocusLayoutSlider_ValueChanged"/>
                                        <TextBlock Text="{Binding ElementName=FocusHeightSlider, Path=Value, StringFormat={}{0:F0} px}" 
                                                   Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Badge Settings -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}"><Run Text="&#xE7C1;" FontFamily="Segoe MDL2 Assets"/><Run Text=" Badge Settings"/></TextBlock>
                                <CheckBox x:Name="ShowBadgeCheckBox" Content="Show Badge" IsChecked="True" 
                                          Checked="FocusVisibilityCheckBox_Changed" Unchecked="FocusVisibilityCheckBox_Changed"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Badge Size" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                        <Slider x:Name="BadgeSizeSlider" Minimum="50" Maximum="200" 
                                                Value="140" TickFrequency="10" IsSnapToTickEnabled="True"
                                                ValueChanged="FocusLayoutSlider_ValueChanged"/>
                                        <TextBlock Text="{Binding ElementName=BadgeSizeSlider, Path=Value, StringFormat={}{0:F0} px}" 
                                                   Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Badge Corner Radius" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                        <Slider x:Name="BadgeCornerSlider" Minimum="0" Maximum="50"
                                                Value="5" TickFrequency="5" IsSnapToTickEnabled="True"
                                                ValueChanged="FocusLayoutSlider_ValueChanged"/>
                                        <TextBlock Text="{Binding ElementName=BadgeCornerSlider, Path=Value, StringFormat={}{0:F0} px}" 
                                                   Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Container Settings -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}"><Run Text="&#xE71D;" FontFamily="Segoe MDL2 Assets"/><Run Text=" Container Settings"/></TextBlock>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Container Corner Radius" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                        <Slider x:Name="ContainerCornerSlider" Minimum="0" Maximum="30" 
                                                Value="8" TickFrequency="2" IsSnapToTickEnabled="True"
                                                ValueChanged="FocusLayoutSlider_ValueChanged"/>
                                        <TextBlock Text="{Binding ElementName=ContainerCornerSlider, Path=Value, StringFormat={}{0:F0} px}" 
                                                   Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Outer Margin" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                        <Slider x:Name="ContainerMarginSlider" Minimum="0" Maximum="20" 
                                                Value="5" TickFrequency="1" IsSnapToTickEnabled="True"
                                                ValueChanged="FocusLayoutSlider_ValueChanged"/>
                                        <TextBlock Text="{Binding ElementName=ContainerMarginSlider, Path=Value, StringFormat={}{0:F0} px}" 
                                                   Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="Content Spacing (Badge to Text)" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                    <Slider x:Name="ContentSpacingSlider" Minimum="0" Maximum="40" 
                                            Value="15" TickFrequency="5" IsSnapToTickEnabled="True"
                                            ValueChanged="FocusLayoutSlider_ValueChanged"/>
                                    <TextBlock Text="{Binding ElementName=ContentSpacingSlider, Path=Value, StringFormat={}{0:F0} px}" 
                                               Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Element Visibility -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}"><Run Text="&#xE890;" FontFamily="Segoe MDL2 Assets"/><Run Text=" Element Visibility"/></TextBlock>
                                <WrapPanel>
                                    <CheckBox x:Name="ShowTitleCheckBox" Content="Title" IsChecked="True" Margin="0,0,15,5"
                                              Checked="FocusVisibilityCheckBox_Changed" Unchecked="FocusVisibilityCheckBox_Changed"/>
                                    <CheckBox x:Name="ShowLineCheckBox" Content="Separator Line" IsChecked="True" Margin="0,0,15,5"
                                              Checked="FocusVisibilityCheckBox_Changed" Unchecked="FocusVisibilityCheckBox_Changed"/>
                                    <CheckBox x:Name="ShowPointsCheckBox" Content="Points" IsChecked="True" Margin="0,0,15,5"
                                              Checked="FocusVisibilityCheckBox_Changed" Unchecked="FocusVisibilityCheckBox_Changed"/>
                                    <CheckBox x:Name="ShowDescriptionCheckBox" Content="Description" IsChecked="True" Margin="0,0,15,5"
                                              Checked="FocusVisibilityCheckBox_Changed" Unchecked="FocusVisibilityCheckBox_Changed"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Font Sizes -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}"><Run Text="&#xE8D2;" FontFamily="Segoe MDL2 Assets"/><Run Text=" Font Sizes"/></TextBlock>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,10,10">
                                        <TextBlock Text="Title Font Size" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                        <Slider x:Name="TitleFontSizeSlider" Minimum="12" Maximum="48" 
                                                Value="26" TickFrequency="2" IsSnapToTickEnabled="True"
                                                ValueChanged="FocusLayoutSlider_ValueChanged"/>
                                        <TextBlock Text="{Binding ElementName=TitleFontSizeSlider, Path=Value, StringFormat={}{0:F0} pt}" 
                                                   Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="1" Grid.Row="0" Margin="10,0,0,10">
                                        <TextBlock Text="Points Font Size" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                        <Slider x:Name="PointsFontSizeSlider" Minimum="16" Maximum="60" 
                                                Value="36" TickFrequency="2" IsSnapToTickEnabled="True"
                                                ValueChanged="FocusLayoutSlider_ValueChanged"/>
                                        <TextBlock Text="{Binding ElementName=PointsFontSizeSlider, Path=Value, StringFormat={}{0:F0} pt}" 
                                                   Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,10,0">
                                        <TextBlock Text="Description Font Size" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                        <Slider x:Name="DescriptionFontSizeSlider" Minimum="10" Maximum="32" 
                                                Value="16" TickFrequency="2" IsSnapToTickEnabled="True"
                                                ValueChanged="FocusLayoutSlider_ValueChanged"/>
                                        <TextBlock Text="{Binding ElementName=DescriptionFontSizeSlider, Path=Value, StringFormat={}{0:F0} pt}" 
                                                   Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="1" Grid.Row="1" Margin="10,0,0,0">
                                        <TextBlock Text="Mastery Info Font Size" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                        <Slider x:Name="MasteryFontSizeSlider" Minimum="12" Maximum="40" 
                                                Value="20" TickFrequency="2" IsSnapToTickEnabled="True"
                                                ValueChanged="FocusLayoutSlider_ValueChanged"/>
                                        <TextBlock Text="{Binding ElementName=MasteryFontSizeSlider, Path=Value, StringFormat={}{0:F0} pt}" 
                                                   Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Line Settings -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}"><Run Text="&#xE738;" FontFamily="Segoe MDL2 Assets"/><Run Text=" Separator Line"/></TextBlock>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Line Height" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                        <Slider x:Name="LineHeightSlider" Minimum="1" Maximum="10" 
                                                Value="4" TickFrequency="1" IsSnapToTickEnabled="True"
                                                ValueChanged="FocusLayoutSlider_ValueChanged"/>
                                        <TextBlock Text="{Binding ElementName=LineHeightSlider, Path=Value, StringFormat={}{0:F0} px}" 
                                                   Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Line Margin (Top/Bottom)" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                        <Slider x:Name="LineMarginSlider" Minimum="0" Maximum="20" 
                                                Value="8" TickFrequency="2" IsSnapToTickEnabled="True"
                                                ValueChanged="FocusLayoutSlider_ValueChanged"/>
                                        <TextBlock Text="{Binding ElementName=LineMarginSlider, Path=Value, StringFormat={}{0:F0} px}" 
                                                   Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Alerts Settings Page -->
            <Grid x:Name="AlertsSettingsPage" Visibility="Collapsed">
                <Grid.RenderTransform>
                    <TranslateTransform/>
                </Grid.RenderTransform>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <!-- Header with Back Button -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Button Content="{loc:Loc Settings_Back}" ContentStringFormat="&#x2190; {0}" Style="{StaticResource BackButton}" Click="NavigateBackToDashboard_Click"/>
                            <TextBlock Style="{StaticResource PageHeader}"><Run Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets"/><Run Text=" "/><Run Text="{loc:Loc Settings_Alerts}"/></TextBlock>
                        </StackPanel>
                        
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Alert Settings" Style="{StaticResource SectionHeader}"/>
                                <CheckBox Content="Enable Achievement Alerts" IsChecked="True"/>
                                <CheckBox Content="Enable Mastery Alerts" IsChecked="True"/>
                                <CheckBox Content="Auto-launch Alerts window on start" IsChecked="{Binding AutoLaunchAlerts}"/>
                                
                                <Separator Margin="0,15" Background="{StaticResource BorderColor}"/>
                                
                                <TextBlock Text="Test Alerts" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                
                                <!-- Core Set Alerts -->
                                <Border Background="#1A4EC9B0" BorderBrush="{StaticResource AccentGreen}"
                                        BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,5,0"/>
                                            <TextBlock Text="Core Set" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentGreen}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource ModernButton}" Command="{Binding TestAchievementAlertCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                    <TextBlock Text="{loc:Loc Alerts_TestAchievement}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource ModernButton}" Command="{Binding TestMasteryAlertCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                    <TextBlock Text="{loc:Loc Alerts_TestMastery}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Subset/Bonus Alerts -->
                                <Border Background="#1AFFD700" BorderBrush="{StaticResource AccentGold}"
                                        BorderThickness="1" CornerRadius="4" Padding="10">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,5,0"/>
                                            <TextBlock Text="Subset / Bonus" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentGold}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource ModernButton}" Command="{Binding TestSubsetAchievementAlertCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                    <TextBlock Text="{loc:Loc Alerts_TestSubsetAchievement}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource ModernButton}" Command="{Binding TestSubsetMasteryAlertCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                    <TextBlock Text="{loc:Loc Alerts_TestSubsetMastery}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Alert Container Shape -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Alerts_AlertContainer}" Style="{StaticResource SectionHeader}"/>
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                                           Foreground="{StaticResource TextMuted}" FontSize="12"
                                           Text="Resize and reshape the alert panel. Height 0 sizes it to its content (the default banner). Moving the badge to the top or bottom turns the banner into a card; hiding it gives a text-only strip."/>
                                <WrapPanel>
                                    <StackPanel Margin="0,0,12,8">
                                        <TextBlock Text="Width" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                        <TextBox x:Name="AlertWidthTextBox" Width="70" LostFocus="AlertLayoutSetting_Changed"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,8">
                                        <TextBlock Text="Height (0=auto)" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                        <TextBox x:Name="AlertHeightTextBox" Width="90" LostFocus="AlertLayoutSetting_Changed"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,8">
                                        <TextBlock Text="Padding" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                        <TextBox x:Name="AlertPaddingTextBox" Width="70" LostFocus="AlertLayoutSetting_Changed"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,8">
                                        <TextBlock Text="Corner radius" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                        <TextBox x:Name="AlertCornerRadiusTextBox" Width="80" LostFocus="AlertLayoutSetting_Changed"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,8">
                                        <TextBlock Text="Badge position" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                        <ComboBox x:Name="AlertBadgePlacementComboBox" Width="100"
                                                  SelectionChanged="AlertLayoutSetting_Changed"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,8">
                                        <TextBlock Text="Badge size" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                        <TextBox x:Name="AlertBadgeSizeTextBox" Width="70" LostFocus="AlertLayoutSetting_Changed"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,8">
                                        <TextBlock Text="Badge radius" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                        <TextBox x:Name="AlertBadgeRadiusTextBox" Width="80" LostFocus="AlertLayoutSetting_Changed"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,8">
                                        <TextBlock Text="Badge/text gap" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                        <TextBox x:Name="AlertContentSpacingTextBox" Width="90" LostFocus="AlertLayoutSetting_Changed"/>
                                    </StackPanel>
                                </WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button x:Name="AlertEditModeButton" Content="{loc:Loc Alerts_EditLayout}"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="ToggleAlertEditMode_Click"/>
                                    <Button Content="{loc:Loc Alerts_ResetDefaults}" Style="{StaticResource ModernButton}"
                                            Click="ResetAlertLayout_Click"/>
                                </StackPanel>
                                <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                                           FontSize="11" Foreground="{StaticResource TextMuted}"
                                           Text="Edit Layout pins the alert on screen with your video looping behind it: drag the panel to move it, drag the blue box to move the video, scroll over it to scale. Changes save as you go."/>
                            </StackPanel>
                        </Border>

                        <!-- Custom Video Alerts -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel x:Name="CustomAlertsPanel">
                                <TextBlock Text="{loc:Loc Alerts_CustomVideo}" Style="{StaticResource SectionHeader}"/>
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                                           Foreground="{StaticResource TextMuted}" FontSize="12"
                                           Text="Play your own alpha-transparent .webm behind the alert panel. In/Out are positions on the VIDEO's timeline, not durations — the panel appears at In and leaves at Out, so it can land on a specific frame."/>

                                <!-- Achievement -->
                                <Border Background="#1A4EC9B0" BorderBrush="{StaticResource AccentGreen}"
                                        BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <CheckBox x:Name="CustomAchievementEnabledCheckBox"
                                                  Content="Use a custom video for achievement alerts"
                                                  FontWeight="SemiBold" Margin="0,0,0,8"
                                                  Checked="CustomAlertSetting_Changed" Unchecked="CustomAlertSetting_Changed"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBox x:Name="CustomAchievementPathTextBox" Width="330"
                                                     VerticalAlignment="Center" IsReadOnly="True"
                                                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                            <Button Content="{loc:Loc Common_Browse}" Style="{StaticResource ModernButton}"
                                                    Click="BrowseCustomAchievementVideo_Click"/>
                                            <Button Content="{loc:Loc Common_Clear}" Style="{StaticResource ModernButton}"
                                                    Click="ClearCustomAchievementVideo_Click"/>
                                        </StackPanel>
                                        <WrapPanel>
                                            <StackPanel Margin="0,0,12,6">
                                                <TextBlock Text="X" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                                <TextBox x:Name="CustomAchievementXTextBox" Width="70"
                                                         LostFocus="CustomAlertSetting_Changed"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,6">
                                                <TextBlock Text="Y" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                                <TextBox x:Name="CustomAchievementYTextBox" Width="70"
                                                         LostFocus="CustomAlertSetting_Changed"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,6">
                                                <TextBlock Text="Scale" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                                <TextBox x:Name="CustomAchievementScaleTextBox" Width="70"
                                                         LostFocus="CustomAlertSetting_Changed"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,6">
                                                <TextBlock Text="In (ms)" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                                <TextBox x:Name="CustomAchievementInTextBox" Width="70"
                                                         LostFocus="CustomAlertSetting_Changed"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,6">
                                                <TextBlock Text="Out (ms)" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                                <TextBox x:Name="CustomAchievementOutTextBox" Width="70"
                                                         LostFocus="CustomAlertSetting_Changed"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,6">
                                                <TextBlock Text="In-Animation" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                                <ComboBox x:Name="CustomAchievementInDirectionComboBox" Width="100"
                                                          SelectionChanged="CustomAlertSetting_Changed"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,6">
                                                <TextBlock Text="In speed (ms)" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                                <TextBox x:Name="CustomAchievementInSpeedTextBox" Width="85"
                                                         ToolTip="How long the panel takes to animate in. 0 snaps instantly (what STATIC uses)."
                                                         LostFocus="CustomAlertSetting_Changed"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,6">
                                                <TextBlock Text="Out-Animation" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                                <ComboBox x:Name="CustomAchievementOutDirectionComboBox" Width="100"
                                                          SelectionChanged="CustomAlertSetting_Changed"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,6">
                                                <TextBlock Text="Out speed (ms)" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                                <TextBox x:Name="CustomAchievementOutSpeedTextBox" Width="85"
                                                         ToolTip="How long the panel takes to animate out."
                                                         LostFocus="CustomAlertSetting_Changed"/>
                                            </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Mastery -->
                                <Border Background="#1AFFD700" BorderBrush="{StaticResource AccentGold}"
                                        BorderThickness="1" CornerRadius="4" Padding="10">
                                    <StackPanel>
                                        <CheckBox x:Name="CustomMasteryEnabledCheckBox"
                                                  Content="Use a custom video for mastery alerts"
                                                  FontWeight="SemiBold" Margin="0,0,0,8"
                                                  Checked="CustomAlertSetting_Changed" Unchecked="CustomAlertSetting_Changed"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBox x:Name="CustomMasteryPathTextBox" Width="330"
                                                     VerticalAlignment="Center" IsReadOnly="True"
                                                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                            <Button Content="{loc:Loc Common_Browse}" Style="{StaticResource ModernButton}"
                                                    Click="BrowseCustomMasteryVideo_Click"/>
                                            <Button Content="{loc:Loc Common_Clear}" Style="{StaticResource ModernButton}"
                                                    Click="ClearCustomMasteryVideo_Click"/>
                                        </StackPanel>
                                        <WrapPanel>
                                            <StackPanel Margin="0,0,12,6">
                                                <TextBlock Text="X" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                                <TextBox x:Name="CustomMasteryXTextBox" Width="70"
                                                         LostFocus="CustomAlertSetting_Changed"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,6">
                                                <TextBlock Text="Y" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                                <TextBox x:Name="CustomMasteryYTextBox" Width="70"
                                                         LostFocus="CustomAlertSetting_Changed"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,6">
                                                <TextBlock Text="Scale" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                                <TextBox x:Name="CustomMasteryScaleTextBox" Width="70"
                                                         LostFocus="CustomAlertSetting_Changed"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,6">
                                                <TextBlock Text="In (ms)" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                                <TextBox x:Name="CustomMasteryInTextBox" Width="70"
                                                         LostFocus="CustomAlertSetting_Changed"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,6">
                                                <TextBlock Text="Out (ms)" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                                <TextBox x:Name="CustomMasteryOutTextBox" Width="70"
                                                         LostFocus="CustomAlertSetting_Changed"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,6">
                                                <TextBlock Text="In-Animation" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                                <ComboBox x:Name="CustomMasteryInDirectionComboBox" Width="100"
                                                          SelectionChanged="CustomAlertSetting_Changed"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,6">
                                                <TextBlock Text="In speed (ms)" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                                <TextBox x:Name="CustomMasteryInSpeedTextBox" Width="85"
                                                         ToolTip="How long the panel takes to animate in. 0 snaps instantly (what STATIC uses)."
                                                         LostFocus="CustomAlertSetting_Changed"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,6">
                                                <TextBlock Text="Out-Animation" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                                <ComboBox x:Name="CustomMasteryOutDirectionComboBox" Width="100"
                                                          SelectionChanged="CustomAlertSetting_Changed"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,6">
                                                <TextBlock Text="Out speed (ms)" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                                <TextBox x:Name="CustomMasteryOutSpeedTextBox" Width="85"
                                                         ToolTip="How long the panel takes to animate out."
                                                         LostFocus="CustomAlertSetting_Changed"/>
                                            </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- User Info Settings Page -->
            <Grid x:Name="UserInfoSettingsPage" Visibility="Collapsed">
                <Grid.RenderTransform>
                    <TranslateTransform/>
                </Grid.RenderTransform>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <!-- Header with Back Button -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Button Content="{loc:Loc Settings_Back}" ContentStringFormat="&#x2190; {0}" Style="{StaticResource BackButton}" Click="NavigateBackToDashboard_Click"/>
                            <TextBlock Style="{StaticResource PageHeader}"><Run Text="&#xE77B;" FontFamily="Segoe MDL2 Assets"/><Run Text=" User Info Settings"/></TextBlock>
                        </StackPanel>
                        
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="User Info Overlay" Style="{StaticResource SectionHeader}"/>
                                <CheckBox Content="Auto-launch User Info window on start" IsChecked="{Binding AutoLaunchUserInfo}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Open User Info Window" Style="{StaticResource PrimaryButton}" 
                                            Command="{Binding OpenUserInfoOverlayCommand}"/>
                                    <Button x:Name="ResetUserInfoLayoutButton" Content="{loc:Loc Alerts_ResetDefaults}"
                                            Style="{StaticResource ModernButton}" Click="ResetUserInfoLayoutButton_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}"><Run Text="&#xE740;" FontFamily="Segoe MDL2 Assets"/><Run Text=" Window Size"/></TextBlock>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Width" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                        <Slider x:Name="UserInfoWidthSlider" Minimum="200" Maximum="800" 
                                                Value="400" TickFrequency="50" IsSnapToTickEnabled="True"
                                                ValueChanged="UserInfoLayoutSlider_ValueChanged"/>
                                        <TextBlock Text="{Binding ElementName=UserInfoWidthSlider, Path=Value, StringFormat={}{0:F0} px}" 
                                                   Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Height" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                        <Slider x:Name="UserInfoHeightSlider" Minimum="100" Maximum="400" 
                                                Value="200" TickFrequency="25" IsSnapToTickEnabled="True"
                                                ValueChanged="UserInfoLayoutSlider_ValueChanged"/>
                                        <TextBlock Text="{Binding ElementName=UserInfoHeightSlider, Path=Value, StringFormat={}{0:F0} px}" 
                                                   Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}"><Run Text="&#xE890;" FontFamily="Segoe MDL2 Assets"/><Run Text=" Element Visibility"/></TextBlock>
                                <WrapPanel>
                                    <CheckBox x:Name="UserInfoShowRankCheckBox" Content="Rank" IsChecked="True" Margin="0,0,15,5"
                                              Checked="UserInfoVisibilityCheckBox_Changed" Unchecked="UserInfoVisibilityCheckBox_Changed"/>
                                    <CheckBox x:Name="UserInfoShowPointsCheckBox" Content="Points" IsChecked="True" Margin="0,0,15,5"
                                              Checked="UserInfoVisibilityCheckBox_Changed" Unchecked="UserInfoVisibilityCheckBox_Changed"/>
                                    <CheckBox x:Name="UserInfoShowTruePointsCheckBox" Content="True Points" IsChecked="True" Margin="0,0,15,5"
                                              Checked="UserInfoVisibilityCheckBox_Changed" Unchecked="UserInfoVisibilityCheckBox_Changed"/>
                                    <CheckBox x:Name="UserInfoShowRatioCheckBox" Content="Ratio" IsChecked="True" Margin="0,0,15,5"
                                              Checked="UserInfoVisibilityCheckBox_Changed" Unchecked="UserInfoVisibilityCheckBox_Changed"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}"><Run Text="&#xE8D2;" FontFamily="Segoe MDL2 Assets"/><Run Text=" Font Sizes"/></TextBlock>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Label Font Size" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                        <Slider x:Name="UserInfoLabelFontSizeSlider" Minimum="10" Maximum="36" 
                                                Value="18" TickFrequency="2" IsSnapToTickEnabled="True"
                                                ValueChanged="UserInfoLayoutSlider_ValueChanged"/>
                                        <TextBlock Text="{Binding ElementName=UserInfoLabelFontSizeSlider, Path=Value, StringFormat={}{0:F0} pt}" 
                                                   Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Value Font Size" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                        <Slider x:Name="UserInfoValueFontSizeSlider" Minimum="12" Maximum="48" 
                                                Value="24" TickFrequency="2" IsSnapToTickEnabled="True"
                                                ValueChanged="UserInfoLayoutSlider_ValueChanged"/>
                                        <TextBlock Text="{Binding ElementName=UserInfoValueFontSizeSlider, Path=Value, StringFormat={}{0:F0} pt}" 
                                                   Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Game Info Settings Page -->
            <Grid x:Name="GameInfoSettingsPage" Visibility="Collapsed">
                <Grid.RenderTransform>
                    <TranslateTransform/>
                </Grid.RenderTransform>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <!-- Header with Back Button -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Button Content="{loc:Loc Settings_Back}" ContentStringFormat="&#x2190; {0}" Style="{StaticResource BackButton}" Click="NavigateBackToDashboard_Click"/>
                            <TextBlock Style="{StaticResource PageHeader}"><Run Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets"/><Run Text=" Game Info Settings"/></TextBlock>
                        </StackPanel>
                        
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Game Info Overlay" Style="{StaticResource SectionHeader}"/>
                                <CheckBox Content="Auto-launch Game Info window on start" IsChecked="{Binding AutoLaunchGameInfo}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Open Game Info Window" Style="{StaticResource PrimaryButton}" 
                                            Command="{Binding OpenGameInfoOverlayCommand}"/>
                                    <Button x:Name="ResetGameInfoLayoutButton" Content="{loc:Loc Alerts_ResetDefaults}"
                                            Style="{StaticResource ModernButton}" Click="ResetGameInfoLayoutButton_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}"><Run Text="&#xE740;" FontFamily="Segoe MDL2 Assets"/><Run Text=" Window Size"/></TextBlock>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Width" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                        <Slider x:Name="GameInfoWidthSlider" Minimum="300" Maximum="900" 
                                                Value="500" TickFrequency="50" IsSnapToTickEnabled="True"
                                                ValueChanged="GameInfoLayoutSlider_ValueChanged"/>
                                        <TextBlock Text="{Binding ElementName=GameInfoWidthSlider, Path=Value, StringFormat={}{0:F0} px}" 
                                                   Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Height" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                        <Slider x:Name="GameInfoHeightSlider" Minimum="200" Maximum="600" 
                                                Value="320" TickFrequency="25" IsSnapToTickEnabled="True"
                                                ValueChanged="GameInfoLayoutSlider_ValueChanged"/>
                                        <TextBlock Text="{Binding ElementName=GameInfoHeightSlider, Path=Value, StringFormat={}{0:F0} px}" 
                                                   Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}"><Run Text="&#xE7C1;" FontFamily="Segoe MDL2 Assets"/><Run Text=" Badge Settings"/></TextBlock>
                                <CheckBox x:Name="GameInfoShowBadgeCheckBox" Content="Show Badge" IsChecked="True" 
                                          Checked="GameInfoVisibilityCheckBox_Changed" Unchecked="GameInfoVisibilityCheckBox_Changed"/>
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="Badge Size" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                    <Slider x:Name="GameInfoBadgeSizeSlider" Minimum="48" Maximum="192" 
                                            Value="96" TickFrequency="8" IsSnapToTickEnabled="True"
                                            ValueChanged="GameInfoLayoutSlider_ValueChanged"/>
                                    <TextBlock Text="{Binding ElementName=GameInfoBadgeSizeSlider, Path=Value, StringFormat={}{0:F0} px}" 
                                               Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}"><Run Text="&#xE890;" FontFamily="Segoe MDL2 Assets"/><Run Text=" Element Visibility"/></TextBlock>
                                <WrapPanel>
                                    <CheckBox x:Name="GameInfoShowTitleCheckBox" Content="Title" IsChecked="True" Margin="0,0,15,5"
                                              Checked="GameInfoVisibilityCheckBox_Changed" Unchecked="GameInfoVisibilityCheckBox_Changed"/>
                                    <CheckBox x:Name="GameInfoShowConsoleCheckBox" Content="Console" IsChecked="True" Margin="0,0,15,5"
                                              Checked="GameInfoVisibilityCheckBox_Changed" Unchecked="GameInfoVisibilityCheckBox_Changed"/>
                                    <CheckBox x:Name="GameInfoShowDeveloperCheckBox" Content="Developer" IsChecked="True" Margin="0,0,15,5"
                                              Checked="GameInfoVisibilityCheckBox_Changed" Unchecked="GameInfoVisibilityCheckBox_Changed"/>
