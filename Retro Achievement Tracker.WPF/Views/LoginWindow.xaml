<Window x:Class="RATracker.WPF.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="RetroAchievements Login"
        Height="720" Width="520"
        MinHeight="500" MinWidth="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowState="Minimized"
        Background="#1E1E1E">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Status bar -->
        <Border Grid.Row="0" Background="#252526" Padding="12,8">
            <DockPanel>
                <TextBlock x:Name="StatusText" Text="Loading..."
                           Foreground="#CCCCCC" VerticalAlignment="Center"
                           FontSize="13"/>
                <TextBlock x:Name="StatusDetail" Text=""
                           Foreground="#888888" VerticalAlignment="Center"
                           Margin="8,0,0,0" FontSize="11"
                           DockPanel.Dock="Right" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>

        <!-- WebView2 browser -->
        <wv2:WebView2 x:Name="LoginWebView" Grid.Row="1"
                       DefaultBackgroundColor="Transparent"/>

        <!-- Bottom button bar -->
        <Border Grid.Row="2" Background="#252526" Padding="12,8">
            <DockPanel>
                <Button x:Name="CancelButton" Content="Cancel" DockPanel.Dock="Right"
                        Click="Cancel_Click" Padding="16,6" Margin="8,0,0,0"
                        Background="#333333" Foreground="#CCCCCC" BorderThickness="0"
                        Cursor="Hand"/>
                <TextBlock Text="Log in to establish a session for V2 API access"
                           Foreground="#888888" VerticalAlignment="Center"
                           FontSize="11" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
