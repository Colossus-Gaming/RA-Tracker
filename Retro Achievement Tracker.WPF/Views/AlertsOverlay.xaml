<Window x:Class="RATracker.WPF.Views.AlertsOverlay"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:controls="clr-namespace:RATracker.WPF.Controls"
xmlns:converters="clr-namespace:RATracker.WPF.Converters"
xmlns:vm="clr-namespace:RATracker.WPF.ViewModels"
xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
mc:Ignorable="d"
        Title="Alerts Overlay"
        Width="{Binding WindowWidth, Mode=TwoWay}"
        Height="{Binding WindowHeight, Mode=TwoWay}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        ResizeMode="CanResizeWithGrip"
        SizeChanged="Window_SizeChanged"
        d:DataContext="{d:DesignInstance Type=vm:AlertsViewModel, IsDesignTimeCreatable=True}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:StringToImageSourceConverter x:Key="StringToImageSource"/>
        
        <!-- Easing Functions -->
        <CubicEase x:Key="EaseOut" EasingMode="EaseOut"/>
        <BackEase x:Key="BackEaseOut" EasingMode="EaseOut" Amplitude="0.3"/>
        <ElasticEase x:Key="ElasticEase" EasingMode="EaseOut" Oscillations="1" Springiness="5"/>
    </Window.Resources>

    <Canvas x:Name="OverlayCanvas" Background="Transparent">
        <!-- Custom-alert video surface. WebView2 rather than MediaElement because alert .webm files
             are VP8/VP9 with an alpha channel, which MediaElement cannot decode. Declared first so
             it sits beneath the notification panel, and hit-test invisible so it never swallows the
             drag used to reposition the overlay. Collapsed unless a custom alert is playing. -->
        <!-- WebView2 hosts native child HWNDs ("Chrome Legacy Window") that take OS mouse input
             across the whole control rect. Neither IsHitTestVisible="False", IsEnabled="False", nor
             WS_EX_TRANSPARENT on the children stops it — all three verified against WindowFromPoint.
             So while the video is on screen nothing beneath it is clickable in WPF. Edit mode works
             around this by having the page forward pointer events back to the host (see the
             setEditMode/edit hooks in VideoPageHtml) and doing the drag maths in C#. -->
        <wv2:WebView2 x:Name="VideoView"
                      Canvas.Left="0" Canvas.Top="0"
                      Width="{Binding WindowWidth}"
                      Height="{Binding WindowHeight}"
                      Visibility="Collapsed"/>

        <!-- Edit-mode outline showing the custom video's bounds. Purely visual: the video can't be
             dragged in WPF because WebView2's native child window takes the mouse, so the drag is
             driven by pointer events the page forwards back to the host. Note the outline falls
             outside the window entirely when the video is scaled up, which is why edit mode also
             shows a numeric readout. -->
        <Border x:Name="VideoEditHandle"
                Canvas.Left="0" Canvas.Top="0"
                Visibility="Collapsed"
                Background="#1800A0FF"
                BorderBrush="#FF00A0FF"
                BorderThickness="2"
                IsHitTestVisible="False"/>

        <!-- Draggable positioning guide (visible only in Position Mode) -->
        <Border x:Name="PositioningGuide"
                Canvas.Left="0"
                Canvas.Top="0"
                Width="{Binding WindowWidth}"
                Height="{Binding WindowHeight}"
                Background="Transparent"
                Visibility="Collapsed"
                IsHitTestVisible="True">
            <Grid>
                <!-- Dashed border using Rectangle -->
                <Rectangle Stroke="#40FF9500" 
                           StrokeThickness="2"
                           StrokeDashArray="4 2"
                           RadiusX="5"
                           RadiusY="5"
                           Margin="5"/>
                <!-- Label with instructions -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Alerts Overlay" 
                               FontSize="14" 
                               Foreground="#80FF9500"
                               HorizontalAlignment="Center"
                               FontFamily="Segoe UI"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="(Press P to exit position mode)" 
                               FontSize="10" 
                               Foreground="#60FF9500"
                               HorizontalAlignment="Center"
                               FontFamily="Segoe UI"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Achievement Notification Container -->
        <Border x:Name="AchievementContainer"
                Canvas.Left="{Binding AchievementLeft}"
                Canvas.Top="{Binding AchievementTop}"
                Width="{Binding NotificationWidth}"
                Height="{Binding NotificationHeightValue}"
                Background="{Binding BackgroundColor}"
                CornerRadius="{Binding ContainerCornerRadiusValue}"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5"
                MouseLeftButtonDown="AchievementContainer_MouseLeftButtonDown"
                MouseMove="AchievementContainer_MouseMove"
                MouseLeftButtonUp="AchievementContainer_MouseLeftButtonUp">
            <Border.RenderTransform>
                <TranslateTransform x:Name="AchievementTransform"/>
            </Border.RenderTransform>
            
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding BorderEnabled}" Value="True">
                            <Setter Property="BorderThickness" Value="3"/>
                            <Setter Property="BorderBrush" Value="{Binding EffectiveBorderColor}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.7"/>
            </Border.Effect>
            
            <Grid>
            <!-- DockPanel rather than a fixed two-column Grid so the badge can sit on any edge
                 (or be hidden). That, plus an explicit container height, is what lets the alert
                 be reshaped away from the default wide banner. -->
            <DockPanel Margin="{Binding ContainerPaddingThickness}" LastChildFill="True">

                <!-- Badge -->
                <Border DockPanel.Dock="{Binding BadgeDock}"
                        Margin="{Binding BadgeMargin}"
                        CornerRadius="{Binding BadgeCornerRadiusValue}"
                        ClipToBounds="True"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding BadgeVisible, Converter={StaticResource BoolToVis}}">
                    <Image Source="{Binding BadgeUri, Converter={StaticResource StringToImageSource}}"
                           Width="{Binding BadgeSize}"
                           Height="{Binding BadgeSize}"
                           Stretch="UniformToFill"/>
                </Border>

                <!-- Content (fills whatever the badge leaves) -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Title -->
                    <controls:OutlinedTextBlock 
                        Grid.Row="0"
                        Text="{Binding Title}"
                        TextFontFamily="{Binding TitleFontFamily}"
                        TextFontSize="{Binding TitleFontSize}"
                        TextFontWeight="Bold"
                        TextColor="{Binding TitleColor}"
                        StrokeColor="{Binding TitleStrokeColor}"
                        StrokeThickness="{Binding TitleStrokeSize}"
                        StrokeEnabled="{Binding TitleStrokeEnabled}"
                        TextWrapping="NoWrap"/>
                    
                    <!-- Separator Line -->
                    <Rectangle Grid.Row="1"
                               Height="{Binding LineHeight}"
                               Fill="{Binding LineColor}"
                               RadiusX="2" RadiusY="2"
                               Margin="0,8,0,8"/>
                    
                    <!-- Description + Points (Achievement Mode) -->
                    <Grid Grid.Row="2">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMasteryNotification}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Points -->
                        <controls:OutlinedTextBlock 
                            Grid.Column="0"
                            Text="{Binding Points}"
                            TextFontFamily="{Binding PointsFontFamily}"
                            TextFontSize="{Binding PointsFontSize}"
                            TextFontWeight="Bold"
                            TextColor="{Binding PointsColor}"
                            StrokeColor="{Binding PointsStrokeColor}"
                            StrokeThickness="{Binding PointsStrokeSize}"
                            StrokeEnabled="{Binding PointsStrokeEnabled}"
                            VerticalTextAlignment="Bottom"
                            Margin="0,0,10,0"/>
                        
                        <!-- Description -->
                        <controls:OutlinedTextBlock 
                            Grid.Column="1"
                            Text="{Binding Description}"
                            TextFontFamily="{Binding DescriptionFontFamily}"
                            TextFontSize="{Binding DescriptionFontSize}"
                            TextFontWeight="Normal"
                            TextColor="{Binding DescriptionColor}"
                            StrokeColor="{Binding DescriptionStrokeColor}"
                            StrokeThickness="{Binding DescriptionStrokeSize}"
                            StrokeEnabled="{Binding DescriptionStrokeEnabled}"
                            TextWrapping="Wrap"
                            VerticalTextAlignment="Center"/>
                    </Grid>
                    
                    <!-- Mastery Info (Mastery Mode) -->
                    <Grid Grid.Row="2">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMasteryNotification}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Mastery Achievements -->
                        <controls:OutlinedTextBlock 
                            Grid.Column="0"
                            Text="{Binding MasteryAchievements}"
                            TextFontFamily="{Binding DescriptionFontFamily}"
                            TextFontSize="{Binding MasteryInfoFontSize}"
                            TextFontWeight="Bold"
                            TextColor="{Binding DescriptionColor}"
                            StrokeColor="{Binding DescriptionStrokeColor}"
                            StrokeThickness="{Binding DescriptionStrokeSize}"
                            StrokeEnabled="{Binding DescriptionStrokeEnabled}"
                            TextAlignment="Center"
                            VerticalTextAlignment="Center"/>
                        
                        <!-- Mastery Points -->
                        <controls:OutlinedTextBlock 
                            Grid.Column="1"
                            Text="{Binding MasteryPoints}"
                            TextFontFamily="{Binding DescriptionFontFamily}"
                            TextFontSize="{Binding MasteryInfoFontSize}"
                            TextFontWeight="Bold"
                            TextColor="{Binding PointsColor}"
                            StrokeColor="{Binding PointsStrokeColor}"
                            StrokeThickness="{Binding PointsStrokeSize}"
                            StrokeEnabled="{Binding PointsStrokeEnabled}"
                            TextAlignment="Center"
                            VerticalTextAlignment="Center"/>
                    </Grid>
                </Grid>
            </DockPanel>

            <!-- Set-type badge (shown only for non-core achievement notifications) -->
            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,-6,-6,0"
                    Padding="8,2"
                    CornerRadius="8"
                    Background="{Binding SetBadgeBackground}"
                    Visibility="{Binding SetBadgeVisible, Converter={StaticResource BoolToVis}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.6"/>
                </Border.Effect>
                <TextBlock Text="{Binding SetBadgeText}"
                           Foreground="White"
                           FontFamily="Segoe UI"
                           FontWeight="Bold"
                           FontSize="12"/>
            </Border>
            </Grid>
        </Border>

        <!-- Edit-mode readout. Declared last so it draws above everything, and hit-test invisible so
             it never intercepts a drag. Needed because a scaled-up video's rect (and therefore its
             drag handle's borders) can fall entirely outside the window, leaving no on-screen cue. -->
        <Border x:Name="EditInfoChip"
                Canvas.Left="8" Canvas.Top="8"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                Background="#E6101010"
                BorderBrush="#FF00A0FF" BorderThickness="1"
                CornerRadius="4" Padding="9,6">
            <StackPanel>
                <TextBlock Text="EDIT MODE"
                           Foreground="#FF00A0FF" FontFamily="Segoe UI"
                           FontSize="11" FontWeight="Bold"/>
                <TextBlock x:Name="EditInfoText"
                           Foreground="White" FontFamily="Consolas" FontSize="11"
                           Margin="0,4,0,0"/>
                <TextBlock Text="drag panel / drag elsewhere to move video / scroll to scale"
                           Foreground="#FF9AA0A6" FontFamily="Segoe UI" FontSize="10"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
    </Canvas>
</Window>
