<Window x:Class="RATracker.WPF.Views.GameProgressOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:RATracker.WPF.Controls"
        xmlns:vm="clr-namespace:RATracker.WPF.ViewModels"
        mc:Ignorable="d"
        Title="Game Progress Overlay"
        Width="{Binding WindowWidth, Mode=TwoWay}"
        Height="{Binding WindowHeight, Mode=TwoWay}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        SizeChanged="Window_SizeChanged"
        d:DataContext="{d:DesignInstance Type=vm:GameProgressViewModel, IsDesignTimeCreatable=True}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <!-- Easing Functions -->
        <CubicEase x:Key="EaseOut" EasingMode="EaseOut"/>
        
        <!-- Show Animation -->
        <Storyboard x:Key="ShowAnimation">
            <DoubleAnimation 
                Storyboard.TargetName="MainContainer"
                Storyboard.TargetProperty="Opacity"
                From="0" To="1" Duration="0:0:0.4"
                EasingFunction="{StaticResource EaseOut}"/>
            <DoubleAnimation 
                Storyboard.TargetName="ContainerScale"
                Storyboard.TargetProperty="ScaleX"
                From="0.9" To="1" Duration="0:0:0.4"
                EasingFunction="{StaticResource EaseOut}"/>
            <DoubleAnimation 
                Storyboard.TargetName="ContainerScale"
                Storyboard.TargetProperty="ScaleY"
                From="0.9" To="1" Duration="0:0:0.4"
                EasingFunction="{StaticResource EaseOut}"/>
        </Storyboard>
        
        <!-- Hide Animation -->
        <Storyboard x:Key="HideAnimation">
            <DoubleAnimation 
                Storyboard.TargetName="MainContainer"
                Storyboard.TargetProperty="Opacity"
                From="1" To="0" Duration="0:0:0.3"
                EasingFunction="{StaticResource EaseOut}"/>
            <DoubleAnimation 
                Storyboard.TargetName="ContainerScale"
                Storyboard.TargetProperty="ScaleX"
                From="1" To="0.9" Duration="0:0:0.3"
                EasingFunction="{StaticResource EaseOut}"/>
            <DoubleAnimation 
                Storyboard.TargetName="ContainerScale"
                Storyboard.TargetProperty="ScaleY"
                From="1" To="0.9" Duration="0:0:0.3"
                EasingFunction="{StaticResource EaseOut}"/>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <!-- Draggable positioning guide (visible when content is hidden) -->
        <Border x:Name="PositioningGuide" Background="Transparent">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ElementName=MainContainer, Path=Opacity}" Value="1">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Rectangle Stroke="#40FFD700" 
                           StrokeThickness="2"
                           StrokeDashArray="4 2"
                           RadiusX="5"
                           RadiusY="5"
                           Margin="5"/>
                <TextBlock Text="Game Progress Overlay" 
                           FontSize="14" 
                           Foreground="#80FFD700"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="Segoe UI"
                           FontWeight="SemiBold"/>
            </Grid>
        </Border>

        <!-- Main Container -->
        <Border x:Name="MainContainer"
            Background="{Binding BackgroundColor}"
            CornerRadius="{Binding ContainerCornerRadiusValue}"
            Margin="{Binding ContainerMarginValue}"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="ContainerScale"/>
        </Border.RenderTransform>
        
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderThickness" Value="0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding BorderEnabled}" Value="True">
                        <Setter Property="BorderThickness" Value="3"/>
                        <Setter Property="BorderBrush" Value="{Binding BorderColor}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.6"/>
        </Border.Effect>
        
        <Grid Margin="15">
            <StackPanel VerticalAlignment="Center">
                <!-- Achievements Row -->
                <Grid Margin="{Binding RowSpacingValue}"
                      Visibility="{Binding ShowAchievements, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <controls:OutlinedTextBlock 
                        Grid.Column="0"
                        Text="{Binding AchievementsLabel}"
                        TextFontFamily="{Binding LabelFontFamily}"
                        TextFontSize="{Binding LabelFontSize}"
                        TextFontWeight="Bold"
                        TextColor="{Binding LabelColor}"
                        StrokeColor="{Binding LabelStrokeColor}"
                        StrokeThickness="{Binding LabelStrokeSize}"
                        StrokeEnabled="{Binding LabelStrokeEnabled}"
                        Margin="0,0,10,0"/>
                    
                    <controls:OutlinedTextBlock 
                        Grid.Column="1"
                        Text="{Binding AchievementsValue}"
                        TextFontFamily="{Binding ValueFontFamily}"
                        TextFontSize="{Binding ValueFontSize}"
                        TextFontWeight="Normal"
                        TextColor="{Binding ValueColor}"
                        StrokeColor="{Binding ValueStrokeColor}"
                        StrokeThickness="{Binding ValueStrokeSize}"
                        StrokeEnabled="{Binding ValueStrokeEnabled}"/>
                </Grid>
                
                <!-- Points Row -->
                <Grid Margin="{Binding RowSpacingValue}"
                      Visibility="{Binding ShowPoints, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <controls:OutlinedTextBlock 
                        Grid.Column="0"
                        Text="{Binding PointsLabel}"
                        TextFontFamily="{Binding LabelFontFamily}"
                        TextFontSize="{Binding LabelFontSize}"
                        TextFontWeight="Bold"
                        TextColor="{Binding LabelColor}"
                        StrokeColor="{Binding LabelStrokeColor}"
                        StrokeThickness="{Binding LabelStrokeSize}"
                        StrokeEnabled="{Binding LabelStrokeEnabled}"
                        Margin="0,0,10,0"/>
                    
                    <controls:OutlinedTextBlock 
                        Grid.Column="1"
                        Text="{Binding PointsValue}"
                        TextFontFamily="{Binding ValueFontFamily}"
                        TextFontSize="{Binding ValueFontSize}"
                        TextFontWeight="Normal"
                        TextColor="{Binding ValueColor}"
                        StrokeColor="{Binding ValueStrokeColor}"
                        StrokeThickness="{Binding ValueStrokeSize}"
                        StrokeEnabled="{Binding ValueStrokeEnabled}"/>
                </Grid>
                
                <!-- True Points Row -->
                <Grid Margin="{Binding RowSpacingValue}"
                      Visibility="{Binding ShowTruePoints, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <controls:OutlinedTextBlock 
                        Grid.Column="0"
                        Text="{Binding TruePointsLabel}"
                        TextFontFamily="{Binding LabelFontFamily}"
                        TextFontSize="{Binding LabelFontSize}"
                        TextFontWeight="Bold"
                        TextColor="{Binding LabelColor}"
                        StrokeColor="{Binding LabelStrokeColor}"
                        StrokeThickness="{Binding LabelStrokeSize}"
                        StrokeEnabled="{Binding LabelStrokeEnabled}"
                        Margin="0,0,10,0"/>
                    
                    <controls:OutlinedTextBlock 
                        Grid.Column="1"
                        Text="{Binding TruePointsValue}"
                        TextFontFamily="{Binding ValueFontFamily}"
                        TextFontSize="{Binding ValueFontSize}"
                        TextFontWeight="Normal"
                        TextColor="{Binding ValueColor}"
                        StrokeColor="{Binding ValueStrokeColor}"
                        StrokeThickness="{Binding ValueStrokeSize}"
                        StrokeEnabled="{Binding ValueStrokeEnabled}"/>
                </Grid>
                
                <!-- Ratio Row -->
                <Grid Margin="{Binding RowSpacingValue}"
                      Visibility="{Binding ShowRatio, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <controls:OutlinedTextBlock 
                        Grid.Column="0"
                        Text="{Binding RatioLabel}"
                        TextFontFamily="{Binding LabelFontFamily}"
                        TextFontSize="{Binding LabelFontSize}"
                        TextFontWeight="Bold"
                        TextColor="{Binding LabelColor}"
                        StrokeColor="{Binding LabelStrokeColor}"
                        StrokeThickness="{Binding LabelStrokeSize}"
                        StrokeEnabled="{Binding LabelStrokeEnabled}"
                        Margin="0,0,10,0"/>
                    
                    <controls:OutlinedTextBlock 
                        Grid.Column="1"
                        Text="{Binding RatioValue}"
                        TextFontFamily="{Binding ValueFontFamily}"
                        TextFontSize="{Binding ValueFontSize}"
                        TextFontWeight="Normal"
                        TextColor="{Binding ValueColor}"
                        StrokeColor="{Binding ValueStrokeColor}"
                        StrokeThickness="{Binding ValueStrokeSize}"
                        StrokeEnabled="{Binding ValueStrokeEnabled}"/>
                </Grid>
                
                <!-- Completed Row -->
                <Grid Margin="{Binding RowSpacingValue}"
                      Visibility="{Binding ShowCompleted, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <controls:OutlinedTextBlock 
                        Grid.Column="0"
                        Text="{Binding CompletedLabel}"
                        TextFontFamily="{Binding LabelFontFamily}"
                        TextFontSize="{Binding LabelFontSize}"
                        TextFontWeight="Bold"
                        TextColor="{Binding LabelColor}"
                        StrokeColor="{Binding LabelStrokeColor}"
                        StrokeThickness="{Binding LabelStrokeSize}"
                        StrokeEnabled="{Binding LabelStrokeEnabled}"
                        Margin="0,0,10,0"/>
                    
                    <controls:OutlinedTextBlock 
                        Grid.Column="1"
                        Text="{Binding CompletedValue}"
                        TextFontFamily="{Binding ValueFontFamily}"
                        TextFontSize="{Binding ValueFontSize}"
                        TextFontWeight="Normal"
                        TextColor="{Binding ValueColor}"
                        StrokeColor="{Binding ValueStrokeColor}"
                        StrokeThickness="{Binding ValueStrokeSize}"
                        StrokeEnabled="{Binding ValueStrokeEnabled}"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
    </Grid>
</Window>
