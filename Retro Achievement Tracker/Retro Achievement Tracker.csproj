<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup>
<TargetFramework>net8.0-windows</TargetFramework>
<OutputType>WinExe</OutputType>
<AssemblyName>RATracker</AssemblyName>
<RootNamespace>RATracker</RootNamespace>
<UseWindowsForms>true</UseWindowsForms>
<UseWPF>true</UseWPF>
<ImplicitUsings>enable</ImplicitUsings>
<StartupObject>RATracker.Program</StartupObject>
  <ApplicationIcon>Resources\image.ico</ApplicationIcon>
</PropertyGroup>
<PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
  <DebugType>none</DebugType>
</PropertyGroup>
<PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x86'">
  <OutputPath>bin\x86\Debug\</OutputPath>
</PropertyGroup>
<PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x86'">
  <OutputPath>bin\x86\Release\</OutputPath>
</PropertyGroup>
<PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">
  <OutputPath>bin\x64\Debug\</OutputPath>
</PropertyGroup>
<ItemGroup>
  <PackageReference Include="Autoupdater.NET.Official" Version="1.9.2" />
  <PackageReference Include="HtmlAgilityPack" Version="1.11.65" />
  <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2739.15" />
  <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters" Version="2.2.1" />
  <PackageReference Include="CoreWCF.Primitives" Version="1.8.0" />
  <PackageReference Include="CoreWCF.ConfigurationManager" Version="1.8.0" />
  <PackageReference Include="CoreWCF.Http" Version="1.8.0" />
  <PackageReference Include="CoreWCF.WebHttp" Version="1.8.0" />
  <PackageReference Include="CoreWCF.NetTcp" Version="1.8.0" />
</ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\game-info-window.html" />
    <Resource Include="Resources\recent-achievements-window.html" />
    <EmbeddedResource Include="Resources\achievement-list-window.html" />
    <Resource Include="Resources\related-media-window.html" />
    <Content Include="Resources\game-progress-window.html" />
    <Content Include="Resources\mastered-icon.PNG" />
    <Content Include="Resources\progression-meter.png" />
    <Content Include="Resources\retro-achievements-banner.png" />
    <Content Include="video\achievement-notification.webm">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="video\mastery-notification.webm">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="images\notification-background.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="Resources\focus-window.html" />
    <EmbeddedResource Include="Resources\user-info-window.html" />
    <EmbeddedResource Include="Resources\alerts-window.html" />
    <Content Include="Resources\image.ico" />
  </ItemGroup>
  <ItemGroup>
    <PublishFile Include="CefSharp.BrowserSubprocess.Core">
      <Visible>False</Visible>
      <Group>
      </Group>
      <TargetPath>
      </TargetPath>
      <PublishState>Include</PublishState>
      <IncludeHash>True</IncludeHash>
      <FileType>Assembly</FileType>
    </PublishFile>
    <PublishFile Include="chrome_elf">
      <Visible>False</Visible>
      <Group>
      </Group>
      <TargetPath>
      </TargetPath>
      <PublishState>Include</PublishState>
      <IncludeHash>True</IncludeHash>
      <FileType>Assembly</FileType>
    </PublishFile>
    <PublishFile Include="libcef">
      <Visible>False</Visible>
      <Group>
      </Group>
      <TargetPath>
      </TargetPath>
      <PublishState>Include</PublishState>
      <IncludeHash>True</IncludeHash>
      <FileType>Assembly</FileType>
    </PublishFile>
  </ItemGroup>
</Project>