<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Deliberately net8.0, NOT net8.0-windows. That is the whole point of this project: it is the
         platform-neutral half of the app (RetroAchievements API access, mapping, tracking, settings,
         stream labels) with no UI framework dependency, so a WPF shell and an Avalonia shell can
         both consume it. -->
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>RATracker.Core</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- CA1416 (platform compatibility) is a warning by default, so a Windows-only call would
         build clean here and only fail at runtime on macOS or Linux - the exact surprise this
         project exists to prevent. Promoting it to an error is what actually enforces the
         neutrality above; without it the TFM alone guarantees nothing. Code that genuinely needs
         a Windows API must say so with [SupportedOSPlatform("windows")] and sit behind an
         abstraction, the way DPAPI sits behind ICredentialProtector. -->
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <WarningsAsErrors>$(WarningsAsErrors);CA1416</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- Cross-platform package; DPAPI itself is Windows-only at runtime, which is why credential
         protection sits behind ICredentialProtector. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- Velopack supports Windows, macOS and Linux, so the updater stays in the shared core. -->
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

</Project>
